<!DOCTYPE html>
<html>
<head>
    <title>Movie List</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <h1>Movie List</h1>

    <a class="add-button" href="/addmovie">Add Movie</a>

    <div class="movie-container">

        <% movies.forEach(function(movie) { %>

            <div class="movie-card">

                <img src="/images/<%= movie.title.toLowerCase() %>.jpg" alt="Movie Poster">

                <h2><%= movie.title %></h2>

                <p>Release Year: <%= movie.year %></p>

                <a class="edit-button" href="/edit/<%= movie._id %>">
                    Edit
                </a>

                <a class="delete-button" href="/delete/<%= movie._id %>">
                    Delete
                </a>

            </div>

        <% }); %>

    </div>

</body>
</html>